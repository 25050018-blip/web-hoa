<!DOCTYPE html>
<html lang="vi" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TIẾN THÀNH ĐÀ LẠT - Haute Floristry & High Jewelry</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,700&family=Montserrat:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,700;0,900;1,400&display=swap" rel="stylesheet">
    
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        obsidian: '#08080A',
                        anthracite: '#121216',             
                        'anthracite-card': '#191921',
                        'anthracite-light': '#22222E',
                        'gold-champagne': '#F5E6AD',
                        'gold-main': '#D4AF37',
                        'gold-dark': '#A27810',
                        'gold-light': '#FFF3C4',
                        bordeaux: '#720917',
                        'bordeaux-dark': '#4A000B',
                    },
                    fontFamily: {
                        serif: ['"Playfair Display"', 'serif'],
                        garamond: ['"Cormorant Garamond"', 'serif'],
                        sans: ['Montserrat', 'sans-serif'],
                    },
                    boxShadow: {
                        'gold-glow': '0 0 25px rgba(212, 175, 55, 0.3)',
                        'gold-glow-lg': '0 0 50px rgba(212, 175, 55, 0.45)',
                        'bordeaux-glow': '0 0 30px rgba(114, 9, 23, 0.5)',
                    }
                }
            }
        }
    </script>

    <style>
        body {
            background-color: #08080A;
            color: #E2E8F0;
            font-family: 'Montserrat', sans-serif;
            overflow-x: hidden;
        }

        /* Metallic Gold Gradient Text */
        .text-gold-gradient {
            background: linear-gradient(135deg, #FFF3C4 0%, #D4AF37 35%, #AA7C11 70%, #F5E6AD 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* Glassmorphism Dark Card */
        .glass-card {
            background: rgba(25, 25, 33, 0.82);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(212, 175, 55, 0.25);
        }

        .glass-card:hover {
            border-color: rgba(212, 175, 55, 0.7);
            box-shadow: 0 0 35px rgba(212, 175, 55, 0.3);
        }

        /* Button Shine Effect */
        .btn-gold {
            background: linear-gradient(135deg, #D4AF37 0%, #AA7C11 100%);
            color: #08080A;
            font-weight: 700;
            position: relative;
            overflow: hidden;
            transition: all 0.4s ease;
        }

        .btn-gold::after {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: linear-gradient(
                60deg,
                transparent,
                rgba(255, 255, 255, 0.5),
                transparent
            );
            transform: rotate(30deg) translateX(-100%);
            transition: transform 0.8s ease;
        }

        .btn-gold:hover::after {
            transform: rotate(30deg) translateX(100%);
        }

        .btn-gold:hover {
            background: linear-gradient(135deg, #FFF3C4 0%, #D4AF37 100%);
            box-shadow: 0 0 30px rgba(212, 175, 55, 0.6);
            transform: translateY(-2px);
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #08080A;
        }
        ::-webkit-scrollbar-thumb {
            background: #252533;
            border-radius: 4px;
            border: 1px solid rgba(212, 175, 55, 0.3);
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #D4AF37;
        }

        /* Diamond Shimmer Effect */
        @keyframes diamondShimmer {
            0% { opacity: 0.4; transform: scale(0.98); }
            50% { opacity: 1; transform: scale(1.02); filter: drop-shadow(0 0 10px rgba(212, 175, 55, 0.8)); }
            100% { opacity: 0.4; transform: scale(0.98); }
        }

        .shimmer-badge {
            animation: diamondShimmer 3s infinite ease-in-out;
        }
    </style>
</head>
<body class="relative min-h-screen selection:bg-gold-main selection:text-obsidian">

    <div class="bg-gradient-to-r from-obsidian via-bordeaux to-obsidian border-b border-gold-main/30 py-2 text-xs text-gold-champagne tracking-widest uppercase text-center px-4 flex justify-between items-center z-50 relative">
        <div class="hidden md:flex items-center gap-2">
            <i class="fa-solid fa-crown text-gold-main"></i>
            <span>TIẾN THÀNH ĐÀ LẠT - Tuyệt Tác Điện Hoa & Kim Cương Số 1 Việt Nam</span>
        </div>
        <div class="mx-auto md:mx-0 font-garamond italic text-sm text-gold-light">
            ✨ Điện Hoa Maybach & Kim Cương GIA Kiểm Định Độc Bản ✨
        </div>
        <div class="hidden md:flex items-center gap-4">
            <a href="tel:0988888888" class="hover:text-white transition font-bold"><i class="fa-solid fa-phone text-gold-main mr-1"></i> Hotline VIP: 0988 888 888</a>
            <span>|</span>
            <span class="text-gold-main"><i class="fa-solid fa-shield-halved mr-1"></i> Bảo Mật Escrow 100%</span>
        </div>
    </div>

    <header class="sticky top-0 z-40 bg-obsidian/90 backdrop-blur-md border-b border-gold-main/20 transition-all duration-300">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-4">
            
            <!-- Mobile Menu Toggle -->
            <button id="mobileMenuBtn" class="lg:hidden text-gold-main text-2xl p-2 focus:outline-none" aria-label="Open Menu">
                <i class="fa-solid fa-bars-staggered"></i>
            </button>

            <!-- Brand Logo -->
            <a href="#" class="flex items-center gap-3 group">
                <div class="w-11 h-11 rounded-full border-2 border-gold-main/60 flex items-center justify-center bg-anthracite group-hover:border-gold-main group-hover:shadow-gold-glow transition duration-300">
                    <i class="fa-solid fa-gem text-gold-main text-xl group-hover:rotate-12 transition duration-500"></i>
                </div>
                <div class="flex flex-col">
                    <span class="font-serif text-xl sm:text-2xl lg:text-3xl tracking-widest text-gold-gradient font-bold uppercase">TIẾN THÀNH ĐÀ LẠT</span>
                    <span class="text-[8px] sm:text-[9px] tracking-[0.35em] uppercase text-gray-400 font-sans -mt-1">Haute Floristry & High Jewelry</span>
                </div>
            </a>

            <!-- Navigation Links -->
            <nav class="hidden lg:flex items-center space-x-7 text-xs uppercase tracking-wider font-semibold text-gray-300">
                <a href="#hero" class="hover:text-gold-main transition-colors py-2 border-b-2 border-transparent hover:border-gold-main">Trang Chủ</a>
                <a href="#about" class="hover:text-gold-main transition-colors py-2 border-b-2 border-transparent hover:border-gold-main">Về Tiến Thành</a>
                <a href="#catalog" onclick="setCategoryFilter('flowers')" class="hover:text-gold-main transition-colors py-2 border-b-2 border-transparent hover:border-gold-main">Hoa Tươi Đà Lạt</a>
                <a href="#catalog" onclick="setCategoryFilter('jewelry')" class="hover:text-gold-main transition-colors py-2 border-b-2 border-transparent hover:border-gold-main">Trang Sức Kim Cương</a>
                <a href="#catalog" onclick="setCategoryFilter('combos')" class="hover:text-gold-main transition-colors py-2 border-b-2 border-transparent hover:border-gold-main text-gold-champagne font-bold"><i class="fa-solid fa-crown text-gold-main mr-1"></i>Combo Độc Bản</a>
                <a href="#privileges" class="hover:text-gold-main transition-colors py-2 border-b-2 border-transparent hover:border-gold-main">Đặc Quyền VIP</a>
            </nav>

            <!-- Actions Right -->
             <div class="flex items-center space-x-3 sm:space-x-4">
                <!-- Search Input Desktop -->
                <div class="relative hidden sm:block w-40 lg:w-56">
                    <input type="text" id="searchInput" placeholder="Tìm kiệt tác..." 
                           class="w-full bg-anthracite border border-gold-main/30 rounded-full py-1.5 pl-8 pr-3 text-xs text-gray-200 placeholder-gray-500 focus:outline-none focus:border-gold-main transition">
                    <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-xs text-gold-main/70"></i>
                </div>

                <!-- Concierge Button -->
                <button onclick="openConciergeModal()" class="hidden sm:flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-gold-main/50 bg-bordeaux/40 text-gold-champagne text-xs hover:bg-bordeaux hover:border-gold-main transition shadow-sm">
                    <i class="fa-solid fa-wand-magic-sparkles text-gold-main"></i>
                    <span class="font-semibold">VIP Concierge</span>
                </button>

                <!-- Cart Button -->
                <button onclick="toggleCartDrawer()" class="relative p-2.5 rounded-full bg-anthracite border border-gold-main/50 text-gold-main hover:bg-gold-main hover:text-obsidian transition duration-300">
                    <i class="fa-solid fa-bag-shopping text-base"></i>
                    <span id="cartBadge" class="absolute -top-1 -right-1 bg-bordeaux text-gold-champagne text-[10px] font-bold w-5 h-5 rounded-full flex items-center justify-center border border-gold-main shadow-md">0</span>
                </button>
            </div>
        </div>

        <!-- Mobile Search Bar -->
        <div class="sm:hidden px-4 pb-3">
            <div class="relative w-full">
                <input type="text" id="searchInputMobile" placeholder="Tìm kiếm kiệt tác hoa & vàng..." 
                       class="w-full bg-anthracite border border-gold-main/30 rounded-full py-2 pl-9 pr-4 text-xs text-gray-200 placeholder-gray-500 focus:outline-none focus:border-gold-main">
                <i class="fa-solid fa-magnifying-glass absolute left-3 top-3 text-xs text-gold-main/70"></i>
            </div>
        </div>
    </header>

    <div id="mobileDrawer" class="fixed inset-0 bg-obsidian/95 z-50 flex flex-col p-6 hidden transition-all duration-300">
        <div class="flex justify-between items-center mb-8 border-b border-gold-main/20 pb-4">
            <span class="font-serif text-xl text-gold-gradient font-bold uppercase">TIẾN THÀNH ĐÀ LẠT</span>
            <button id="closeMobileMenuBtn" class="text-gold-main text-2xl p-2"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <nav class="flex flex-col space-y-6 text-sm uppercase tracking-widest">
            <a href="#hero" onclick="closeMobileMenu()" class="text-gold-champagne hover:text-gold-main"><i class="fa-solid fa-house mr-3 text-gold-main"></i>Trang Chủ</a>
            <a href="#about" onclick="closeMobileMenu()" class="text-gray-200 hover:text-gold-main"><i class="fa-solid fa-gem mr-3 text-gold-main"></i>Về Tiến Thành</a>
            <a href="#catalog" onclick="setCategoryFilter('flowers'); closeMobileMenu();" class="text-gray-200 hover:text-gold-main"><i class="fa-solid fa-rose mr-3 text-gold-main"></i>Hoa Tươi Đà Lạt</a>
            <a href="#catalog" onclick="setCategoryFilter('jewelry'); closeMobileMenu();" class="text-gray-200 hover:text-gold-main"><i class="fa-solid fa-ring mr-3 text-gold-main"></i>Trang Sức Kim Cương</a>
            <a href="#catalog" onclick="setCategoryFilter('combos'); closeMobileMenu();" class="text-gold-gradient font-bold"><i class="fa-solid fa-crown mr-3 text-gold-main"></i>Combo Hoàng Gia</a>
            <a href="#privileges" onclick="closeMobileMenu()" class="text-gray-200 hover:text-gold-main"><i class="fa-solid fa-award mr-3 text-gold-main"></i>Đặc Quyền VIP</a>
        </nav>
        <div class="mt-auto pt-6 border-t border-gold-main/20">
            <button onclick="closeMobileMenu(); openConciergeModal();" class="w-full py-3.5 btn-gold rounded-full text-xs uppercase tracking-wider flex items-center justify-center gap-2">
                <i class="fa-solid fa-wand-magic-sparkles"></i> Tư Vấn AI VIP Concierge
            </button>
        </div>
    </div>

    <section id="hero" class="relative min-h-[88vh] flex items-center justify-center overflow-hidden py-16 px-4">
        <!-- Ambient Radial Glows -->
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-bordeaux-dark/30 via-obsidian to-obsidian pointer-events-none"></div>
        <div class="absolute top-1/3 left-1/2 -translate-x-1/2 w-[650px] h-[650px] bg-gold-main/10 rounded-full blur-[140px] pointer-events-none"></div>

        <div class="max-w-5xl mx-auto text-center relative z-10 flex flex-col items-center">
            
            <!-- Royal Emblem Badge -->
            <div class="inline-flex items-center gap-2 px-5 py-2 rounded-full border border-gold-main/40 bg-anthracite/90 backdrop-blur-md mb-8 shadow-gold-glow shimmer-badge">
                <i class="fa-solid fa-crown text-gold-main text-xs"></i>
                <span class="text-xs uppercase tracking-[0.25em] text-gold-champagne font-semibold">Nghệ Thuật Điện Hoa Đà Lạt & Trang Sức Kim Cương Vàng 24K</span>
            </div>

            <!-- Main Heading -->
            <h1 class="font-serif text-3xl sm:text-5xl md:text-6xl lg:text-7xl text-white font-bold tracking-tight leading-tight mb-6">
                Tuyệt Tác Hoa Tươi Đà Lạt <br class="hidden sm:block">
