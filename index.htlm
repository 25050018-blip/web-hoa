                </div>
            </div>
        </div>
    </section>

    <section id="about" class="py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t border-gold-main/20">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            <div class="space-y-6">
                <span class="text-xs uppercase tracking-[0.3em] text-gold-main font-semibold">Di Sản Hoàng Gia</span>
                <h2 class="font-serif text-3xl sm:text-4xl text-white font-bold leading-snug">
                    Hành Trình Kiến Tạo Kiệt Tác <br>
                    <span class="text-gold-gradient font-garamond italic font-normal">TIẾN THÀNH ĐÀ LẠT</span>
                </h2>
                <div class="w-20 h-0.5 bg-gold-main"></div>
                <p class="text-xs sm:text-sm text-gray-300 leading-relaxed font-light">
                    Khởi nguồn từ thủ phủ hoa Đà Lạt, thương hiệu **TIẾN THÀNH ĐÀ LẠT** không chỉ đơn thuần mang đến những đóa hoa tươi nhập khẩu chọn lọc mà còn kết hợp nghệ thuật chế tác kim cương tự nhiên và vàng 24K nguyên khối từ những nghệ nhân kim hoàn đỉnh cao.
                </p>
                <p class="text-xs sm:text-sm text-gray-300 leading-relaxed font-light">
                    Mỗi tác phẩm là một di sản duy nhất được đặt trong hộp gỗ mun bọc da cao cấp, giao bằng xe Maybach bảo mật và đính kèm giấy chứng nhận GIA/SJC chính hãng.
                </p>
                <div class="flex gap-4 pt-2">
                    <div class="p-3 bg-anthracite rounded-xl border border-gold-main/30 text-center">
                        <i class="fa-solid fa-award text-gold-main text-xl mb-1"></i>
                        <div class="text-[10px] uppercase text-gray-300 font-semibold">Chất Lượng Độc Bản</div>
                    </div>
                    <div class="p-3 bg-anthracite rounded-xl border border-gold-main/30 text-center">
                        <i class="fa-solid fa-user-shield text-gold-main text-xl mb-1"></i>
                        <div class="text-[10px] uppercase text-gray-300 font-semibold">Bảo Mật Danh Tính</div>
                    </div>
                    <div class="p-3 bg-anthracite rounded-xl border border-gold-main/30 text-center">
                        <i class="fa-solid fa-truck-fast text-gold-main text-xl mb-1"></i>
                        <div class="text-[10px] uppercase text-gray-300 font-semibold">Giao Hàng Siêu Xe</div>
                    </div>
                </div>
            </div>
            
            <div class="relative group">
                <div class="absolute -inset-1 bg-gradient-to-r from-gold-main via-bordeaux to-gold-main rounded-2xl blur opacity-30 group-hover:opacity-60 transition"></div>
                <img src="https://images.unsplash.com/photo-1518709268805-4e9042af9f23?q=80&w=1000&auto=format&fit=crop" alt="Tiến Thành Đà Lạt Heritage" class="relative rounded-2xl border border-gold-main/40 w-full h-[380px] object-cover shadow-2xl">
            </div>
        </div>
    </section>
    <section id="catalog" class="py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t border-gold-main/20">
        
        <!-- Section Title Header -->
        <div class="text-center mb-12">
            <span class="text-xs uppercase tracking-[0.3em] text-gold-main font-semibold">Exquisite Collection</span>
            <h2 class="font-serif text-3xl sm:text-4xl text-white font-bold mt-2 mb-3">Bộ Sưu Tập Kiệt Tác Tiến Thành</h2>
            <div class="w-24 h-0.5 bg-gradient-to-r from-transparent via-gold-main to-transparent mx-auto"></div>
        </div>

        <!-- Filter Controls Bar -->
        <div class="mb-10 flex flex-col md:flex-row gap-6 justify-between items-center bg-anthracite/80 p-4 rounded-2xl border border-gold-main/30">
            
            <!-- Category Tabs -->
            <div class="flex flex-wrap gap-2 justify-center md:justify-start w-full md:w-auto">
                <button onclick="setCategoryFilter('all')" class="cat-btn active px-4 py-2 rounded-full text-xs font-semibold uppercase tracking-wider transition bg-gold-main text-obsidian shadow-gold-glow" data-cat="all">Tất Cả</button>
                <button onclick="setCategoryFilter('flowers')" class="cat-btn px-4 py-2 rounded-full text-xs font-semibold uppercase tracking-wider transition bg-anthracite text-gray-300 hover:text-gold-main border border-gold-main/20" data-cat="flowers">Hoa Tươi Đà Lạt</button>
                <button onclick="setCategoryFilter('jewelry')" class="cat-btn px-4 py-2 rounded-full text-xs font-semibold uppercase tracking-wider transition bg-anthracite text-gray-300 hover:text-gold-main border border-gold-main/20" data-cat="jewelry">Trang Sức Kim Cương</button>
                <button onclick="setCategoryFilter('combos')" class="cat-btn px-4 py-2 rounded-full text-xs font-semibold uppercase tracking-wider transition bg-anthracite text-gray-300 hover:text-gold-main border border-gold-main/20" data-cat="combos">Combo VIP Hoàng Gia</button>
            </div>

            <!-- VIP Budget Filter Selector -->
            <div class="flex items-center gap-3 w-full md:w-auto justify-end">
                <label for="budgetFilter" class="text-xs uppercase tracking-wider text-gold-champagne font-semibold whitespace-nowrap"><i class="fa-solid fa-coins text-gold-main mr-1"></i>Ngân Sách VIP:</label>
                <select id="budgetFilter" onchange="applyBudgetFilter()" class="bg-obsidian border border-gold-main/40 text-gold-champagne text-xs rounded-xl px-4 py-2 focus:outline-none focus:border-gold-main cursor-pointer w-full md:w-52 font-medium">
                    <option value="all">Tất Cả Mức Giá</option>
                    <option value="under50">Dưới 50 Triệu VNĐ</option>
                    <option value="50to200">50 - 200 Triệu VNĐ</option>
                    <option value="above500">Trên 500 Triệu - 1 Tỷ+ VNĐ</option>
                    </select>
           </div>
        </div>

        <!-- Product Grid -->
        <div id="productGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
            <!-- Dynamic JS product cards render here -->
        </div>

        <!-- Empty State Filter Result -->
        <div id="noResults" class="hidden text-center py-16 glass-card rounded-2xl">
            <i class="fa-solid fa-gem text-4xl text-gold-main/40 mb-3"></i>
            <h3 class="font-serif text-xl text-white">Không tìm thấy kiệt tác phù hợp</h3>
            <p class="text-xs text-gray-400 mt-1">Quý khách vui lòng điều chỉnh lại bộ lọc danh mục hoặc mức ngân sách VIP.</p>
            <button onclick="resetFilters()" class="mt-4 px-6 py-2.5 btn-gold rounded-full text-xs uppercase tracking-wider font-bold">Đặt lại bộ lọc</button>
        </div>
    </section>

    <div id="conciergeModal" class="fixed inset-0 bg-obsidian/90 backdrop-blur-lg z-50 flex items-center justify-center p-4 hidden">
        <div class="glass-card max-w-2xl w-full rounded-2xl p-6 md:p-8 relative border border-gold-main/50 shadow-gold-glow">
            
            <button onclick="closeConciergeModal()" class="absolute top-4 right-4 text-gold-main text-xl hover:text-white transition"><i class="fa-solid fa-xmark"></i></button>

            <div class="text-center mb-6">
                <div class="w-12 h-12 rounded-full bg-bordeaux/40 border border-gold-main/50 flex items-center justify-center mx-auto mb-2 text-gold-main text-xl">
                    <i class="fa-solid fa-wand-magic-sparkles"></i>
                </div>
                <h3 class="font-serif text-2xl text-gold-gradient font-bold">Trợ Lý AI VIP Concierge Tiến Thành</h3>
                <p class="text-xs text-gray-300 mt-1">Gợi ý phối hợp Hoa Đà Lạt & Trang Sức Hoàng Gia cá nhân hóa</p>
            </div>

            <!-- Form Step 1 -->
            <div id="conciergeStep1" class="space-y-6">
                <div>
                    <label class="block text-xs uppercase tracking-wider text-gold-champagne mb-2 font-semibold">1. Mục đích tặng quà của Quý khách?</label>
                    <div class="grid grid-cols-2 gap-3">
                        <button type="button" onclick="selectOccasion('cauhuan')" class="occasion-btn p-3 rounded-xl border border-gold-main/30 bg-anthracite hover:border-gold-main text-left text-xs text-gray-200 transition flex items-center gap-2">
                            <i class="fa-solid fa-ring text-gold-main"></i> Cầu Hôn / Kỷ Niệm Ngày Cưới
                        </button>
                        <button type="button" onclick="selectOccasion('sinhnhat')" class="occasion-btn p-3 rounded-xl border border-gold-main/30 bg-anthracite hover:border-gold-main text-left text-xs text-gray-200 transition flex items-center gap-2">
             <i class="fa-solid fa-crown text-gold-main"></i> Sinh Nhật Thượng Lưu / Sếp VIP
                        </button>
                        <button type="button" onclick="selectOccasion('totinh')" class="occasion-btn p-3 rounded-xl border border-gold-main/30 bg-anthracite hover:border-gold-main text-left text-xs text-gray-200 transition flex items-center gap-2">
                            <i class="fa-solid fa-heart text-gold-main"></i> Tỏ Tình Đỉnh Cao
                        </button>
                        <button type="button" onclick="selectOccasion('doitac')" class="occasion-btn p-3 rounded-xl border border-gold-main/30 bg-anthracite hover:border-gold-main text-left text-xs text-gray-200 transition flex items-center gap-2">
                            <i class="fa-solid fa-handshake text-gold-main"></i> Tri Ân Đối Tác Chiến Lược
                        </button>
                    </div>
                </div>

                <div>
                    <label class="block text-xs uppercase tracking-wider text-gold-champagne mb-2 font-semibold">2. Ngân sách dự kiến?</label>
                    <div class="grid grid-cols-3 gap-3">
                        <button type="button" onclick="selectBudget('low')" class="concierge-budget-btn p-3 rounded-xl border border-gold-main/30 bg-anthracite hover:border-gold-main text-center text-xs text-gray-200 transition">
                            &lt; 100 Triệu
                        </button>
                        <button type="button" onclick="selectBudget('mid')" class="concierge-budget-btn p-3 rounded-xl border border-gold-main/30 bg-anthracite hover:border-gold-main text-center text-xs text-gray-200 transition">
                            100 - 500 Triệu
                        </button>
                        <button type="button" onclick="selectBudget('high')" class="concierge-budget-btn p-3 rounded-xl border border-gold-main/30 bg-anthracite hover:border-gold-main text-center text-xs text-gray-200 transition">
                            500 Triệu - 1.5 Tỷ+
                        </button>
                    </div>
                </div>

                <button onclick="generateRecommendation()" class="w-full py-3.5 btn-gold rounded-full text-xs uppercase tracking-widest font-bold shadow-gold-glow mt-4">
                    <i class="fa-solid fa-sparkles mr-2"></i> Nhận Gợi Ý Kiệt Tác Độc Bản
                </button>
            </div>

            <!-- Concierge Result -->
            <div id="conciergeResult" class="hidden text-center py-4 space-y-4">
                <div id="recommendedProductCard" class="p-4 border border-gold-main/40 bg-anthracite rounded-xl text-left flex flex-col sm:flex-row gap-4 items-center">
                    <!-- Dynamic Product Output -->
                </div>
                <div class="flex gap-3">
              <button onclick="resetConcierge()" class="w-1/2 py-2.5 rounded-full border border-gold-main/40 text-gold-champagne text-xs uppercase font-semibold">Chọn Lại</button>
                    <button id="addRecommendedBtn" class="w-1/2 py-2.5 btn-gold rounded-full text-xs uppercase font-bold">Thêm Ngay Vào Giỏ</button>
                </div>
            </div>
        </div>
    </div>

    <div id="quickViewModal" class="fixed inset-0 bg-obsidian/90 backdrop-blur-md z-50 flex items-center justify-center p-4 hidden overflow-y-auto">
        <div class="glass-card max-w-4xl w-full rounded-2xl p-6 md:p-8 relative border border-gold-main/50 my-8">
            <button onclick="closeQuickView()" class="absolute top-4 right-4 text-gold-main text-2xl hover:text-white transition z-10"><i class="fa-solid fa-xmark"></i></button>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
                
                <!-- Image & Badges -->
                <div class="relative group">
                    <img id="qvImage" src="" alt="" class="w-full h-[350px] md:h-[420px] object-cover rounded-xl border border-gold-main/30 shadow-2xl">
                    <span id="qvBadge" class="absolute top-3 left-3 bg-bordeaux text-gold-champagne text-[10px] font-bold px-3 py-1 rounded-full border border-gold-main shadow-md">GIA CERTIFIED</span>
                </div>

                <!-- Product Information & Customization -->
                <div class="flex flex-col space-y-4">
                    <span id="qvCategory" class="text-xs uppercase tracking-[0.2em] text-gold-main font-semibold">Hoa Tươi Đà Lạt</span>
                    <h3 id="qvTitle" class="font-serif text-2xl md:text-3xl text-white font-bold leading-snug">Product Title</h3>
                    
                    <div class="flex items-center gap-3">
                        <span id="qvPrice" class="font-serif text-2xl text-gold-gradient font-bold">0 VNĐ</span>
                        <span class="text-xs text-green-400 bg-green-900/30 px-2.5 py-1 rounded-md border border-green-500/30"><i class="fa-solid fa-check-circle mr-1"></i>Giao Xe Maybach Vệ Sĩ</span>
                    </div>

                    <p id="qvDescription" class="text-xs text-gray-300 leading-relaxed font-light">Description paragraph...</p>

                    <!-- Materials Specification -->
                    <div class="bg-anthracite/80 p-3.5 rounded-xl border border-gold-main/20 text-xs space-y-1">
                        <div class="text-gold-champagne font-semibold mb-1 uppercase tracking-wider"><i class="fa-solid fa-scroll text-gold-main mr-1"></i>Nguyên Liệu & Chứng Nhận:</div>
                        <div id="qvMaterials" class="text-gray-300 italic">Hoa tươi chọn lọc Đà Lạt, Kim cương GIA...</div>
                    </div>

                    <!-- Custom Engraving Option -->
                    <div>
                <label for="engravingInput" class="block text-xs uppercase tracking-wider text-gold-champagne mb-1 font-semibold">
                            <i class="fa-solid fa-pen-nib text-gold-main mr-1"></i> Điệp Văn / Khắc Tên Vàng 24K (Miễn Phí):
                        </label>
                        <input type="text" id="engravingInput" placeholder="Ví dụ: Tiến Thành & Ngọc Trinh - Mãi Mãi Bên Nhau" 
                               class="w-full bg-obsidian border border-gold-main/40 text-xs text-gold-champagne px-3 py-2 rounded-lg focus:outline-none focus:border-gold-main">
                    </div>

                    <!-- VIP Delivery Add-ons -->
                    <div>
                        <span class="block text-xs uppercase tracking-wider text-gold-champagne mb-2 font-semibold">
                            <i class="fa-solid fa-concierge-bell text-gold-main mr-1"></i> Dịch Vụ VIP Đi Kèm Tùy Chọn:
                        </span>
                        <div class="space-y-2 text-xs">
                            <label class="flex items-center gap-2 cursor-pointer text-gray-300 hover:text-gold-main">
                                <input type="checkbox" id="addonMaybach" checked class="rounded border-gold-main text-gold-main focus:ring-0">
                                <span>Giao Siêu Xe Maybach & Vệ Sĩ Áp Tải (+0 VNĐ)</span>
                            </label>
                            <label class="flex items-center gap-2 cursor-pointer text-gray-300 hover:text-gold-main">
                                <input type="checkbox" id="addonViolin" class="rounded border-gold-main text-gold-main focus:ring-0">
                                <span>Dàn Nhạc Violin Độc Bản Tới Tận Nơi (+5.000.000 VNĐ)</span>
                            </label>
                            <label class="flex items-center gap-2 cursor-pointer text-gray-300 hover:text-gold-main">
                                <input type="checkbox" id="addonAnonymous" class="rounded border-gold-main text-gold-main focus:ring-0">
                                <span>Giao Hàng Ẩn Danh Bảo Mật Tuyệt Đối</span>
                            </label>
                        </div>
                    </div>

                    <!-- Add to Cart -->
                    <button id="qvAddToCartBtn" onclick="addCurrentQVToCart()" class="w-full py-3.5 btn-gold rounded-full text-xs uppercase tracking-widest font-bold shadow-gold-glow mt-2">
                        <i class="fa-solid fa-bag-shopping mr-2"></i> Thêm Kiệt Tác Vào Giỏ Hàng
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div id="cartDrawer" class="fixed inset-y-0 right-0 w-full max-w-md bg-obsidian/95 border-l border-gold-main/40 z-50 transform translate-x-full transition-transform duration-300 flex flex-col shadow-2xl backdrop-blur-xl">
        
        <!-- Cart Header -->
              <div class="p-6 border-b border-gold-main/20 flex justify-between items-center bg-anthracite/60">
            <div class="flex items-center gap-2">
                <i class="fa-solid fa-bag-shopping text-gold-main text-lg"></i>
                <h3 class="font-serif text-lg text-gold-gradient font-bold uppercase">Giỏ Hàng Tiến Thành VIP</h3>
            </div>
            <button onclick="toggleCartDrawer()" class="text-gold-main text-xl hover:text-white transition"><i class="fa-solid fa-xmark"></i></button>
        </div>

        <!-- Items Container -->
        <div id="cartItemsContainer" class="flex-1 overflow-y-auto p-6 space-y-4">
            <!-- Dynamic Cart Items -->
        </div>

        <!-- Custom Card Message Textarea inside Cart -->
        <div class="px-6 py-2">
            <label class="block text-[11px] uppercase tracking-wider text-gold-champagne mb-1 font-semibold">
                <i class="fa-solid fa-envelope-open-text text-gold-main mr-1"></i> Lời Chúc Mừng Dát Vàng (Nói Với Tiến Thành):
            </label>
            <textarea id="cardMessageInput" rows="2" placeholder="Nhập lời chúc muốn in lên thiệp mạ vàng 24K..." class="w-full bg-obsidian border border-gold-main/30 rounded-lg p-2 text-xs text-gold-champagne focus:outline-none focus:border-gold-main"></textarea>
        </div>

        <!-- Cart Summary & Checkout Trigger -->
        <div class="p-6 border-t border-gold-main/20 bg-anthracite/80 space-y-4">
            <div class="space-y-2 text-xs">
                <div class="flex justify-between text-gray-400">
                    <span>Tạm tính giá trị:</span>
                    <span id="cartSubtotal" class="text-gray-200 font-semibold">0 VNĐ</span>
                </div>
                <div class="flex justify-between text-gray-400">
                    <span>Phí Dịch vụ Maybach & VIP Escrow:</span>
                    <span class="text-gold-main font-semibold">Miễn Phí Hoàng Gia</span>
                </div>
                <div class="flex justify-between text-sm font-bold text-white pt-2 border-t border-gold-main/20">
                    <span>Tổng Thanh Toán:</span>
                    <span id="cartTotal" class="text-gold-gradient text-lg">0 VNĐ</span>
                </div>
            </div>

            <button onclick="openCheckoutModal()" class="w-full py-4 btn-gold rounded-full text-xs uppercase tracking-widest font-bold shadow-gold-glow flex items-center justify-center gap-2">
                <i class="fa-solid fa-credit-card"></i> Tiến Hành Thanh Toán Hoàng Gia
            </button>
        </div>
    </div>

    <div id="checkoutModal" class="fixed inset-0 bg-obsidian/90 backdrop-blur-md z-50 flex items-center justify-center p-4 hidden overflow-y-auto">
        <div class="glass-card max-w-3xl w-full rounded-2xl p-6 md:p-8 relative border border-gold-main/50 my-8">
              <button onclick="closeCheckoutModal()" class="absolute top-4 right-4 text-gold-main text-2xl hover:text-white transition"><i class="fa-solid fa-xmark"></i></button>

            <div class="text-center mb-6">
                <i class="fa-solid fa-crown text-gold-main text-2xl mb-1"></i>
                <h3 class="font-serif text-2xl text-gold-gradient font-bold">Thanh Toán Dịch Vụ VIP Escrow</h3>
                <p class="text-xs text-gray-300">TIẾN THÀNH ĐÀ LẠT - Phòng Xử Lý Đơn Hàng Ưu Tiên VIP</p>
            </div>

            <form id="checkoutForm" onsubmit="handleCheckoutSubmit(event)" class="space-y-4 text-xs">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-gold-champagne mb-1 font-semibold uppercase">Họ và Tên Chủ Khách</label>
                        <input type="text" required placeholder="Nguyễn Văn A" class="w-full bg-obsidian border border-gold-main/40 text-white p-2.5 rounded-lg focus:border-gold-main outline-none">
                    </div>
                    <div>
                        <label class="block text-gold-champagne mb-1 font-semibold uppercase">Số Điện Thoại VIP</label>
                        <input type="tel" required placeholder="0988 888 888" class="w-full bg-obsidian border border-gold-main/40 text-white p-2.5 rounded-lg focus:border-gold-main outline-none">
                    </div>
                </div>

                <div>
                    <label class="block text-gold-champagne mb-1 font-semibold uppercase">Địa Chỉ Giao Hàng Hoàng Gia</label>
                    <input type="text" required placeholder="Biệt thự số 16 Dinh Điện, TP. Đà Lạt / Penthouse Landmark 81..." class="w-full bg-obsidian border border-gold-main/40 text-white p-2.5 rounded-lg focus:border-gold-main outline-none">
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-gold-champagne mb-1 font-semibold uppercase">Khung Giờ Hoàng Đạo Giao Hàng</label>
                        <select class="w-full bg-obsidian border border-gold-main/40 text-gold-champagne p-2.5 rounded-lg focus:border-gold-main outline-none">
                            <option>Giao Cấp Tốc Trong 2 Giờ (Maybach Special)</option>
                            <option>Giờ Hoàng Đạo Sáng (08:08 - 09:09)</option>
                            <option>Giờ Hoàng Đạo Chiều (14:14 - 15:15)</option>
                            <option>Giờ Hoàng Đạo Tối (19:19 - 20:20)</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-gold-champagne mb-1 font-semibold uppercase">Phương Thức Thanh Toán</label>
                        <select class="w-full bg-obsidian border border-gold-main/40 text-gold-champagne p-2.5 rounded-lg focus:border-gold-main outline-none">
                            <option>Chuyển Khoản Ngân Hàng VIP Tiến Thành Escrow</option>
                            <option>Thẻ VIP Amex Centurion / Black Card</option>
                            <option>Thanh Toán Tại Showroom Tiến Thành Đà Lạt</option>
                        </select>
                    </div>
                </div>

                <!-- Total Amount Display -->
                <div class="p-4 bg-anthracite/90 rounded-xl border border-gold-main/30 flex justify-between items-center my-4">
                    <span class="text-gray-300 font-semibold uppercase">Tổng Giá Trị Đơn Hàng:</span>
                    <span id="checkoutTotalAmount" class="text-gold-gradient text-xl font-serif font-bold">0 VNĐ</span>
                </div>

                <button type="submit" class="w-full py-4 btn-gold rounded-full text-xs uppercase tracking-widest font-bold shadow-gold-glow">
                    <i class="fa-solid fa-shield-halved mr-2"></i> Xác Nhận Đặt Hàng Bảo Mật 100%
                </button>
            </form>
        </div>
    </div>

    <div id="orderSuccessModal" class="fixed inset-0 bg-obsidian/95 backdrop-blur-xl z-50 flex items-center justify-center p-4 hidden">
        <div class="glass-card max-w-lg w-full rounded-2xl p-8 text-center border-2 border-gold-main relative shadow-gold-glow-lg">
            
            <div class="w-16 h-16 rounded-full bg-gold-main/20 border border-gold-main flex items-center justify-center mx-auto mb-4 text-gold-main text-3xl">
                <i class="fa-solid fa-crown"></i>
            </div>
            
            <span class="text-[10px] uppercase tracking-[0.3em] text-gold-main font-semibold">TIẾN THÀNH ĐÀ LẠT - VIP CERTIFICATE</span>
            <h3 class="font-serif text-2xl text-gold-gradient font-bold mt-1">Thẻ Chứng Nhận Đơn Hàng Hoàng Gia</h3>
            <p class="text-xs text-gray-300 mt-2 leading-relaxed">
                Kính chào Quý khách. Đội ngũ Private Concierge của TIẾN THÀNH ĐÀ LẠT đang tiến hành chuẩn bị tác phẩm hoa tươi & trang sức vàng đính kim cương với quy trình bảo mật nghiêm ngặt.
            </p>

            <!-- Certificate Data Box -->
            <div class="my-6 p-4 bg-anthracite rounded-xl border border-gold-main/40 text-left text-xs space-y-2.5">
                <div class="flex justify-between border-b border-gold-main/20 pb-2">
                    <span class="text-gray-400">Mã Chứng Nhận VIP:</span>
                    <span id="receiptCode" class="text-gold-champagne font-mono font-bold">TTDL-2026-8899</span>
                </div>
                <div class="flex justify-between border-b border-gold-main/20 pb-2">
                    <span class="text-gray-400">Phương Thức Vận Chuyển:</span>
              <span class="text-gray-200">Xe Maybach & Vệ Sĩ Áp Tải</span>
                </div>
                <div class="flex justify-between border-b border-gold-main/20 pb-2">
                    <span class="text-gray-400">Kiểm Định GIA / SJC 24K:</span>
                    <span class="text-green-400"><i class="fa-solid fa-circle-check mr-1"></i>Đã Đính Kèm Niêm Phong</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-gray-400">Lời Chúc Mừng:</span>
                    <span id="certMessage" class="text-gold-champagne italic">"Trân trọng & Vĩnh cửu"</span>
                </div>
            </div>

            <button onclick="closeSuccessModal()" class="w-full py-3.5 btn-gold rounded-full text-xs uppercase tracking-widest font-bold">
                Hoàn Tất & Trở Về Trang Chủ
            </button>
        </div>
    </div>

    <section id="privileges" class="py-20 bg-anthracite/50 border-t border-b border-gold-main/20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-16">
                <span class="text-xs uppercase tracking-[0.3em] text-gold-main font-semibold">Royal Privilege Standard</span>
                <h2 class="font-serif text-3xl sm:text-4xl text-white font-bold mt-2">Đặc Quyền Thượng Lưu Tiến Thành</h2>
                <div class="w-20 h-0.5 bg-gold-main mx-auto mt-4"></div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                
                <div class="glass-card p-6 rounded-2xl text-center space-y-4 hover:-translate-y-2 transition duration-300">
                    <div class="w-14 h-14 rounded-full bg-obsidian border border-gold-main/40 flex items-center justify-center mx-auto text-gold-main text-2xl">
                        <i class="fa-solid fa-car-side"></i>
                    </div>
                    <h3 class="font-serif text-lg text-gold-champagne font-bold">Xe Maybach Delivery</h3>
                    <p class="text-xs text-gray-400 leading-relaxed">Giao quà bằng dòng xe xa xỉ Maybach có hệ thống lạnh bảo quản hoa Đà Lạt chuẩn 18°C.</p>
                </div>

                <div class="glass-card p-6 rounded-2xl text-center space-y-4 hover:-translate-y-2 transition duration-300">
                    <div class="w-14 h-14 rounded-full bg-obsidian border border-gold-main/40 flex items-center justify-center mx-auto text-gold-main text-2xl">
                        <i class="fa-solid fa-certificate"></i>
                    </div>
                    <h3 class="font-serif text-lg text-gold-champagne font-bold">Kiểm Định GIA / SJC</h3>
                    <p class="text-xs text-gray-400 leading-relaxed">Tất cả kim cương tự nhiên & vàng 24K đều đi kèm chứng thư quốc tế GIA / SJC độc bản.</p>
                </div>
                     <div class="glass-card p-6 rounded-2xl text-center space-y-4 hover:-translate-y-2 transition duration-300">
                    <div class="w-14 h-14 rounded-full bg-obsidian border border-gold-main/40 flex items-center justify-center mx-auto text-gold-main text-2xl">
                        <i class="fa-solid fa-user-shield"></i>
                    </div>
                    <h3 class="font-serif text-lg text-gold-champagne font-bold">Vệ Sĩ Áp Tải Ẩn Danh</h3>
                    <p class="text-xs text-gray-400 leading-relaxed">Dịch vụ bảo mật thông tin 100% hoặc có vệ sĩ VIP áp tải trực tiếp các bộ trang sức giá trị cao.</p>
                </div>

                <div class="glass-card p-6 rounded-2xl text-center space-y-4 hover:-translate-y-2 transition duration-300">
                    <div class="w-14 h-14 rounded-full bg-obsidian border border-gold-main/40 flex items-center justify-center mx-auto text-gold-main text-2xl">
                        <i class="fa-solid fa-pen-fancy"></i>
                    </div>
                    <h3 class="font-serif text-lg text-gold-champagne font-bold">Khắc Vàng 24K Miễn Phí</h3>
                    <p class="text-xs text-gray-400 leading-relaxed">Lời chúc mừng của Quý khách được nghệ nhân khắc thủ công mạ vàng lá 24K sang trọng.</p>
                </div>

            </div>
        </div>
    </section>

    <footer class="bg-obsidian pt-16 pb-8 border-t border-gold-main/20 text-gray-400 text-xs">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-4 gap-10 mb-12">
            
            <div class="space-y-4">
                <a href="#" class="flex items-center gap-3">
                    <i class="fa-solid fa-gem text-gold-main text-2xl"></i>
                    <span class="font-serif text-xl tracking-widest text-gold-gradient font-bold uppercase">TIẾN THÀNH ĐÀ LẠT</span>
                </a>
                <p class="leading-relaxed font-light">
                    Thương hiệu quà tặng thượng lưu hàng đầu Việt Nam, độc quyền kết hợp giữa nghệ thuật điện hoa tươi Đà Lạt & trang sức vàng 24K, kim cương GIA.
                </p>
                <div class="flex space-x-3 text-gold-main text-base">
                    <a href="#" class="w-8 h-8 rounded-full border border-gold-main/30 flex items-center justify-center hover:bg-gold-main hover:text-obsidian transition"><i class="fa-brands fa-instagram"></i></a>
                    <a href="#" class="w-8 h-8 rounded-full border border-gold-main/30 flex items-center justify-center hover:bg-gold-main hover:text-obsidian transition"><i class="fa-brands fa-facebook-f"></i></a>
                    <a href="#" class="w-8 h-8 rounded-full border border-gold-main/30 flex items-center justify-center hover:bg-gold-main hover:text-obsidian transition"><i class="fa-brands fa-youtube"></i></a>
                </div>
            </div>
                <div>
                <h4 class="font-serif text-sm text-gold-champagne font-bold uppercase tracking-wider mb-4">Hệ Thống Showroom Tiến Thành</h4>
                <ul class="space-y-2.5">
                    <li><i class="fa-solid fa-location-dot text-gold-main mr-2"></i> Đà Lạt: 01 Trần Phú, Phường 3 (Dinh Điện VIP)</li>
                    <li><i class="fa-solid fa-location-dot text-gold-main mr-2"></i> TP.HCM: 168 Đồng Khởi, Quận 1</li>
                    <li><i class="fa-solid fa-location-dot text-gold-main mr-2"></i> Hà Nội: 88 Lý Thái Tổ, Hoàn Kiếm</li>
                </ul>
            </div>

            <div>
                <h4 class="font-serif text-sm text-gold-champagne font-bold uppercase tracking-wider mb-4">Dịch Vụ Khách Hàng VIP</h4>
                <ul class="space-y-2.5">
                    <li><a href="#" class="hover:text-gold-main transition">Đặt Lịch Hẹn Tư Vấn Private Suite</a></li>
                    <li><a href="#" class="hover:text-gold-main transition">Quy Trình Kiểm Định Kim Cương GIA</a></li>
                    <li><a href="#" class="hover:text-gold-main transition">Chính Sách Bảo Mật Danh Tính 100%</a></li>
                    <li><a href="#" class="hover:text-gold-main transition">Bảo Hành & Làm Sạch Vàng Trọn Đời</a></li>
                </ul>
            </div>

            <div>
                <h4 class="font-serif text-sm text-gold-champagne font-bold uppercase tracking-wider mb-4">Đăng Ký Nhận Privilege Card</h4>
                <p class="mb-3 font-light">Nhận thông báo về các bộ sưu tập kim cương giới hạn & ưu đãi Private Sale.</p>
                <div class="flex">
                    <input type="email" placeholder="Email Quý khách..." class="bg-anthracite border border-gold-main/30 text-white px-3 py-2 rounded-l-lg text-xs focus:outline-none focus:border-gold-main w-full">
                    <button class="btn-gold px-4 rounded-r-lg uppercase font-bold text-xs"><i class="fa-solid fa-paper-plane"></i></button>
                </div>
            </div>

        </div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 border-t border-gold-main/10 pt-6 flex flex-col md:flex-row justify-between items-center text-gray-500 text-[11px]">
            <p>© 2026 TIẾN THÀNH ĐÀ LẠT - Haute Floristry & High Jewelry. All Rights Reserved.</p>
            <div class="flex space-x-4 mt-2 md:mt-0">
                <a href="#" class="hover:text-gold-main">Privacy Policy</a>
                <span>|</span>
                <a href="#" class="hover:text-gold-main">VIP Escrow Terms</a>
            </div>
        </div>
    </footer>

    <!-- Toast Container -->
    <div id="toastContainer" class="fixed bottom-6 right-6 z-50 flex flex-col space-y-3 pointer-events-none"></div>

    <script>
        
        // Product Data Array (Luxury Tier - Tiến Thành Đà Lạt Branding)
        const products = [
            {
             id: 1,
                title: "Bó 999 Bông Hồng Ecuador - Đà Lạt Phủ Vàng 24K",
                category: "combos",
                price: 299000000,
                priceString: "299.000.000 VNĐ",
                image: "https://images.unsplash.com/photo-1518709268805-4e9042af9f23?q=80&w=800&auto=format&fit=crop",
                badge: "24K GOLD COVER",
                description: "Kiệt tác gồm 999 đóa hồng đỏ tươi tuyển chọn tại vườn hoa Đà Lạt, từng cánh hoa được điểm lá vàng 24K nguyên khối tinh xảo bởi nghệ nhân Tiến Thành.",
                materials: "999 Hoa Hồng Đà Lạt tuyển chọn, Lá Vàng 24K lá thật, Hộp Mun Hoa bọc Da Hoàng Gia.",
                budgetCag: "50to200"
            },
            {
                id: 2,
                title: "Nhẫn Kim Cương Thiên Nhiên GIA 3 Carat 'Tiến Thành Royal'",
                category: "jewelry",
                price: 680000000,
                priceString: "680.000.000 VNĐ",
                image: "https://images.unsplash.com/photo-1605100804763-247f67b3557e?q=80&w=800&auto=format&fit=crop",
                badge: "GIA 3CT SOLITAIRE",
                description: "Nhẫn cầu hôn đỉnh cao chế tác bởi Tiến Thành với viên kim cương tự nhiên 3 Carat nước D, độ tinh khiết VVS1 chứng nhận GIA trên ổ nhẫn Platinum 950.",
                materials: "Kim cương 3.0CT D/VVS1 GIA, Bạch kim Platinum 950, Hộp gỗ sơn mài dát vàng.",
                budgetCag: "above500"
            },
            {
                id: 3,
                title: "Lẵng Lan Hồ Điệp Đột Biến Khung Mạ Vàng 24K Tiến Thành",
                category: "flowers",
                price: 88000000,
                priceString: "88.000.000 VNĐ",
                image: "https://images.unsplash.com/photo-1535632066927-ab7c9ab60908?q=80&w=800&auto=format&fit=crop",
                badge: "RARE ORCHID",
                description: "Chậu 20 cành Lan Hồ Điệp đột biến trắng nhụy tím từ Đà Lạt kết hợp cùng khung đỡ hoa chạm khắc mạ vàng 24K độc bản.",
                materials: "Lan Hồ Điệp Đột Biến Đà Lạt, Khung Đỡ Mạ Vàng 24K, Chậu Gốm Dát Vàng.",
                budgetCag: "50to200"
            },
            {
                id: 4,
                title: "Dây Chuyền Kim Cương & Ngọc Trai South Sea Tiến Thành",
                category: "jewelry",
                price: 195000000,
                priceString: "195.000.000 VNĐ",
                image: "https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?q=80&w=800&auto=format&fit=crop",
                badge: "SOUTH SEA PEARL",
                description: "Mặt dây chuyền ngọc trai biển South Sea vàng kim kích thước 15mm đính dải kim cương tự nhiên 1.2 carat bọc vàng hồng 18K.",
                materials: "Ngọc trai South Sea Gold 15mm, Kim Cương Tự Nhiên 1.2CT, Vàng Hồng 18K.",
                budgetCag: "50to200"
            },
            {
                id: 5,
                title: "Combo 'Vĩnh Cửu': Bó Hoa Hồng Mạ Vàng & Thỏi Vàng PNJ/SJC 999.9 Custom",
                category: "combos",
                price: 120000000,
                priceString: "120.000.000 VNĐ",
                image: "https://images.unsplash.com/photo-1526047932273-341f2a7631f9?q=80&w=800&auto=format&fit=crop",
                badge: "SJC 999.9 CUSTOM",
                description: "Hộp quà xa xỉ kết hợp bó hoa hồng mạ vàng lá 24K lưu giữ vĩnh cửu đi kèm thỏi vàng 1 lượng SJC 999.9 khắc thông điệp riêng theo yêu cầu.",
                materials: "Thỏi Vàng SJC 1 Lượng 999.9, Bó Hoa Hồng Phủ Vàng 24K, Hộp Gỗ Khắc Tên.",
                budgetCag: "50to200"
            },
            {
                id: 6,
                title: "Đồng Hồ Thuỵ Sĩ Đính Kim Cương & Bó Hoa Tulip Nhập Khẩu Đà Lạt",
                category: "combos",
                price: 1500000000,
                priceString: "1.500.000.000 VNĐ",
                image: "https://images.unsplash.com/photo-1522335789203-aabd1fc54bc9?q=80&w=800&auto=format&fit=crop",
                badge: "ULTRA LUXURY 1/1",
                description: "Set quà siêu xa xỉ gồm đồng hồ Thụy Sỹ đính toàn bộ kim cương tự nhiên đặt trong rương gỗ mun bao quanh bởi 101 cành hoa Tulip Hà Lan trồng tại Đà Lạt.",
                materials: "Đồng hồ Thụy Sỹ đính Kim Cương, 101 Tulip Đà Lạt, Rương Khắc Vàng.",
                budgetCag: "above500"
            },
            {
                id: 7,
                title: "Lắc Tay Vàng 24K Khắc Tên Thủ Công Tiến Thành",
                category: "jewelry",
                price: 145000000,
                priceString: "145.000.000 VNĐ",
                image: "https://images.unsplash.com/photo-1611591475140-be3872120257?q=80&w=800&auto=format&fit=crop",
                badge: "24K GOLD 999.9",
                description: "Lắc tay đúc bằng vàng 24K nguyên khối trọng lượng 1.5 lượng, chạm khắc vân rồng phụng thủ công theo tên riêng của chủ nhân.",
                materials: "Vàng 24K nguyên khối 1.5 lượng, Khóa Chốt An Toàn Kim Cương.",
                budgetCag: "50to200"
            },
            {
                id: 8,
                title: "Tuyệt Tác Tháp Hoa & Bộ Trang Sức Cưới Hoàng Gia Tiến Thành",
                category: "combos",
                price: 890000000,
                priceString: "890.000.000 VNĐ",
                image: "https://images.unsplash.com/photo-1569919659476-f0852f6834b7?q=80&w=800&auto=format&fit=crop",
                badge: "ROYAL BRIDAL",
                description: "Tháp hoa tươi Đà Lạt cao 2m kết hợp bộ trang sức cưới 4 món gồm Vòng cổ, Bông tai, Nhẫn & Lắc tay bằng vàng 24K đính kim cương tự nhiên.",
                materials: "Hoa Tươi Đà Lạt Độc Bản, Bộ Trang Sức Vàng 24K (3 lượng) & Kim Cương GIA.",
                budgetCag: "above500"
            }
        ];

        // Global State
        let cart = [];
        let activeCategory = 'all';
              let activeBudget = 'all';
        let currentQVProduct = null;
        let selectedOccasion = '';
        let selectedBudgetConcierge = '';

        document.addEventListener('DOMContentLoaded', () => {
            renderProducts();
            setupSearchListeners();
            setupMobileMenu();
        });

        // Mobile Menu Setup
        function setupMobileMenu() {
            const btn = document.getElementById('mobileMenuBtn');
            const closeBtn = document.getElementById('closeMobileMenuBtn');
            const drawer = document.getElementById('mobileDrawer');

            if (btn && drawer) {
                btn.addEventListener('click', () => drawer.classList.remove('hidden'));
            }
            if (closeBtn && drawer) {
                closeBtn.addEventListener('click', () => drawer.classList.add('hidden'));
            }
        }

        function closeMobileMenu() {
            const drawer = document.getElementById('mobileDrawer');
            if (drawer) drawer.classList.add('hidden');
        }

        // Render Product Catalog Cards
        function renderProducts() {
            const grid = document.getElementById('productGrid');
            const noRes = document.getElementById('noResults');
            const searchVal = (document.getElementById('searchInput').value || '').toLowerCase().trim();

            grid.innerHTML = '';

            const filtered = products.filter(p => {
                const matchCategory = (activeCategory === 'all' || p.category === activeCategory);
                const matchBudget = (activeBudget === 'all' || p.budgetCag === activeBudget);
                const matchSearch = p.title.toLowerCase().includes(searchVal) || p.description.toLowerCase().includes(searchVal);
                return matchCategory && matchBudget && matchSearch;
            });

            if (filtered.length === 0) {
                grid.classList.add('hidden');
                noRes.classList.remove('hidden');
                return;
            } else {
                grid.classList.remove('hidden');
                noRes.classList.add('hidden');
            }

            filtered.forEach(p => {
                const card = document.createElement('div');
                card.className = "glass-card rounded-2xl overflow-hidden flex flex-col group transition duration-500 hover:-translate-y-2 relative border border-gold-main/20";
                
                card.innerHTML = `
                    <div class="relative overflow-hidden h-64 sm:h-72">
                        <img src="${p.image}" alt="${p.title}" class="w-full h-full object-cover group-hover:scale-110 transition duration-700">
                        <div class="absolute inset-0 bg-gradient-to-t from-obsidian via-transparent to-transparent opacity-80"></div>
                            <span class="absolute top-3 left-3 bg-bordeaux/90 backdrop-blur-md text-gold-champagne text-[10px] font-bold tracking-widest px-3 py-1 rounded-full border border-gold-main/50">
                            ${p.badge}
                        </span>
                        <button onclick="openQuickView(${p.id})" class="absolute bottom-3 right-3 bg-obsidian/80 hover:bg-gold-main text-gold-main hover:text-obsidian w-9 h-9 rounded-full flex items-center justify-center border border-gold-main/40 transition shadow-lg" title="Xem Chi Tiết">
                            <i class="fa-solid fa-eye text-xs"></i>
                        </button>
                    </div>

                    <div class="p-5 flex-1 flex flex-col justify-between space-y-3">
                        <div>
                            <span class="text-[10px] uppercase tracking-[0.2em] text-gold-main font-semibold block mb-1">
                                ${getCategoryName(p.category)}
                            </span>
                            <h3 class="font-serif text-sm sm:text-base text-white font-semibold line-clamp-2 hover:text-gold-champagne transition">
                                ${p.title}
                            </h3>
                        </div>

                        <div class="border-t border-gold-main/20 pt-3">
                            <div class="text-xs text-gray-400 mb-1">Giá Niêm Yết Tiến Thành:</div>
                            <div class="font-serif text-lg text-gold-gradient font-bold">${p.priceString}</div>
                        </div>

                        <div class="grid grid-cols-2 gap-2 pt-2">
                            <button onclick="openQuickView(${p.id})" class="py-2 rounded-xl border border-gold-main/40 text-gold-champagne hover:bg-gold-main/10 text-xs font-semibold transition">
                                Chi Tiết
                            </button>
                            <button onclick="directAddToCart(${p.id})" class="py-2 btn-gold rounded-xl text-xs uppercase font-bold tracking-wider">
                                <i class="fa-solid fa-bag-shopping mr-1"></i> Đặt Hàng
                            </button>
                        </div>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        function getCategoryName(cat) {
            switch(cat) {
                case 'flowers': return 'Hoa Tươi Đà Lạt';
                case 'jewelry': return 'Trang Sức Kim Cương';
                case 'combos': return 'Combo VIP Hoàng Gia';
                default: return 'Kiệt Tác Tiến Thành';
            }
        }

        function setCategoryFilter(cat) {
            activeCategory = cat;
            document.querySelectorAll('.cat-btn').forEach(btn => {
                if (btn.dataset.cat === cat) {
                       btn.className = "cat-btn active px-4 py-2 rounded-full text-xs font-semibold uppercase tracking-wider transition bg-gold-main text-obsidian shadow-gold-glow";
                } else {
                    btn.className = "cat-btn px-4 py-2 rounded-full text-xs font-semibold uppercase tracking-wider transition bg-anthracite text-gray-300 hover:text-gold-main border border-gold-main/20";
                }
            });
            renderProducts();
        }

        function applyBudgetFilter() {
            activeBudget = document.getElementById('budgetFilter').value;
            renderProducts();
        }

        function resetFilters() {
            activeCategory = 'all';
            activeBudget = 'all';
            document.getElementById('budgetFilter').value = 'all';
            document.getElementById('searchInput').value = '';
            setCategoryFilter('all');
        }

        function setupSearchListeners() {
            const inputDesk = document.getElementById('searchInput');
            const inputMob = document.getElementById('searchInputMobile');
            
            if (inputDesk) inputDesk.addEventListener('input', renderProducts);
            if (inputMob) inputMob.addEventListener('input', (e) => {
                if (inputDesk) inputDesk.value = e.target.value;
                renderProducts();
            });
        }

        // Quick View Modal Controls
        function openQuickView(id) {
            const product = products.find(p => p.id === id);
            if (!product) return;
            currentQVProduct = product;

            document.getElementById('qvImage').src = product.image;
            document.getElementById('qvTitle').textContent = product.title;
            document.getElementById('qvPrice').textContent = product.priceString;
            document.getElementById('qvDescription').textContent = product.description;
            document.getElementById('qvMaterials').textContent = product.materials;
            document.getElementById('qvBadge').textContent = product.badge;
            document.getElementById('qvCategory').textContent = getCategoryName(product.category);
            document.getElementById('engravingInput').value = '';

            document.getElementById('quickViewModal').classList.remove('hidden');
        }

        function closeQuickView() {
            document.getElementById('quickViewModal').classList.add('hidden');
            currentQVProduct = null;
        }

        function addCurrentQVToCart() {
            if (!currentQVProduct) return;
            const engraving = document.getElementById('engravingInput').value.trim();
            const addonMaybach = document.getElementById('addonMaybach').checked;
            const addonViolin = document.getElementById('addonViolin').checked;
            const addonAnonymous = document.getElementById('addonAnonymous').checked;

            let extraCost = 0;
            let addOnNotes = [];
                  if (addonMaybach) addOnNotes.push("Xe Maybach VIP");
            if (addonViolin) { addOnNotes.push("Dàn Nhạc Violin"); extraCost += 5000000; }
            if (addonAnonymous) addOnNotes.push("Giao Ẩn Danh");

            addToCartState(currentQVProduct, engraving, addOnNotes, extraCost);
            closeQuickView();
            showToast(`Đã thêm "${currentQVProduct.title.substring(0, 20)}..." vào giỏ!`);
            toggleCartDrawer();
        }

        function directAddToCart(id) {
            const product = products.find(p => p.id === id);
            if (!product) return;
            addToCartState(product, "", ["Xe Maybach VIP"], 0);
            showToast(`Đã thêm "${product.title.substring(0, 20)}..." vào giỏ!`);
        }

        function addToCartState(product, engraving, addOnNotes, extraCost) {
            const cartItem = {
                cartId: Date.now(),
                productId: product.id,
                title: product.title,
                price: product.price + extraCost,
                image: product.image,
                engraving: engraving,
                addOnNotes: addOnNotes
            };
            cart.push(cartItem);
            updateCartUI();
        }

        function removeFromCart(cartId) {
            cart = cart.filter(item => item.cartId !== cartId);
            updateCartUI();
            showToast("Đã xóa sản phẩm khỏi giỏ hàng.");
        }

        function updateCartUI() {
            const container = document.getElementById('cartItemsContainer');
            const badge = document.getElementById('cartBadge');
            const subtotalEl = document.getElementById('cartSubtotal');
            const totalEl = document.getElementById('cartTotal');

            badge.textContent = cart.length;

            if (cart.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-16 space-y-3">
                        <i class="fa-solid fa-bag-shopping text-4xl text-gray-600"></i>
                        <p class="text-xs text-gray-400">Giỏ hàng Tiến Thành hiện tại chưa có sản phẩm.</p>
                    </div>
                `;
                subtotalEl.textContent = "0 VNĐ";
                totalEl.textContent = "0 VNĐ";
                return;
            }

            let total = 0;
            container.innerHTML = '';

            cart.forEach(item => {
                total += item.price;
                const itemEl = document.createElement('div');
                itemEl.className = "p-3.5 bg-anthracite/90 rounded-xl border border-gold-main/20 flex gap-3 relative group";
                
                itemEl.innerHTML = `
                    <img src="${item.image}" class="w-16 h-16 rounded-lg object-cover border border-gold-main/30">
                    <div class="flex-1 pr-6 space-y-1">
                        <h4 class="font-serif text-xs text-white font-semibold line-clamp-1">${item.title}</h4>
                               <div class="text-gold-gradient font-bold text-xs">${formatMoney(item.price)} VNĐ</div>
                        ${item.engraving ? `<div class="text-[10px] text-gold-champagne italic"><i class="fa-solid fa-pen-nib mr-1"></i>Khắc: "${item.engraving}"</div>` : ''}
                        ${item.addOnNotes.length ? `<div class="text-[9px] text-gray-400"><i class="fa-solid fa-star text-gold-main mr-1"></i>${item.addOnNotes.join(', ')}</div>` : ''}
                    </div>
                    <button onclick="removeFromCart(${item.cartId})" class="absolute top-2 right-2 text-gray-500 hover:text-bordeaux-light transition text-sm">
                        <i class="fa-solid fa-trash-can"></i>
                    </button>
                `;
                container.appendChild(itemEl);
            });

            subtotalEl.textContent = formatMoney(total) + " VNĐ";
            totalEl.textContent = formatMoney(total) + " VNĐ";
            document.getElementById('checkoutTotalAmount').textContent = formatMoney(total) + " VNĐ";
        }

        function formatMoney(num) {
            return num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ".");
        }

        function toggleCartDrawer() {
            const drawer = document.getElementById('cartDrawer');
            if (drawer.classList.contains('translate-x-full')) {
                drawer.classList.remove('translate-x-full');
            } else {
                drawer.classList.add('translate-x-full');
            }
        }

        // Concierge AI Wizard
        function openConciergeModal() {
            document.getElementById('conciergeModal').classList.remove('hidden');
            resetConcierge();
        }

        function closeConciergeModal() {
            document.getElementById('conciergeModal').classList.add('hidden');
        }

        function selectOccasion(occ) {
            selectedOccasion = occ;
            document.querySelectorAll('.occasion-btn').forEach(btn => btn.classList.remove('border-gold-main', 'bg-gold-main/20'));
            event.currentTarget.classList.add('border-gold-main', 'bg-gold-main/20');
        }

        function selectBudget(bud) {
            selectedBudgetConcierge = bud;
            document.querySelectorAll('.concierge-budget-btn').forEach(btn => btn.classList.remove('border-gold-main', 'bg-gold-main/20'));
            event.currentTarget.classList.add('border-gold-main', 'bg-gold-main/20');
        }

        function resetConcierge() {
            selectedOccasion = '';
            selectedBudgetConcierge = '';
            document.getElementById('conciergeStep1').classList.remove('hidden');
            document.getElementById('conciergeResult').classList.add('hidden');
            document.querySelectorAll('.occasion-btn, .concierge-budget-btn').forEach(btn => btn.classList.remove('border-gold-main', 'bg-gold-main/20'));
        }
      function generateRecommendation() {
        if (!selectedOccasion || !selectedBudgetConcierge) {
                showToast("Vui lòng chọn mục đích và ngân sách!");
                return;
            }

            let recommended = products[0];
            if (selectedBudgetConcierge === 'high') {
                recommended = products.find(p => p.id === 6) || products[1];
            } else if (selectedBudgetConcierge === 'mid') {
                recommended = products.find(p => p.id === 1) || products[4];
            } else {
                recommended = products.find(p => p.id === 3) || products[2];
            }

            const recContainer = document.getElementById('recommendedProductCard');
            recContainer.innerHTML = `
                <img src="${recommended.image}" class="w-24 h-24 rounded-xl object-cover border border-gold-main/40">
                <div class="space-y-1">
                    <span class="text-[10px] text-gold-main uppercase tracking-widest font-semibold">${getCategoryName(recommended.category)}</span>
                    <h4 class="font-serif text-sm text-white font-bold">${recommended.title}</h4>
                    <p class="text-xs text-gray-300 line-clamp-2">${recommended.description}</p>
                    <div class="text-gold-gradient font-serif font-bold text-base mt-1">${recommended.priceString}</div>
                </div>
            `;

            document.getElementById('addRecommendedBtn').onclick = () => {
                directAddToCart(recommended.id);
                closeConciergeModal();
                toggleCartDrawer();
            };

            document.getElementById('conciergeStep1').classList.add('hidden');
            document.getElementById('conciergeResult').classList.remove('hidden');
        }

        // Checkout & Electronic Certificate Engine
        function openCheckoutModal() {
            if (cart.length === 0) {
                showToast("Giỏ hàng chưa có sản phẩm!");
                return;
            }
            toggleCartDrawer();
            document.getElementById('checkoutModal').classList.remove('hidden');
        }

        function closeCheckoutModal() {
            document.getElementById('checkoutModal').classList.add('hidden');
        }

        function handleCheckoutSubmit(e) {
            e.preventDefault();
            closeCheckoutModal();

            const randomCode = 'TTDL-2026-' + Math.floor(1000 + Math.random() * 9000);
            document.getElementById('receiptCode').textContent = randomCode;

            const userMessage = document.getElementById('cardMessageInput').value.trim();
            document.getElementById('certMessage').textContent = userMessage ? `"${userMessage}"` : `"Trân trọng & Vĩnh Cửu"`;

            cart = [];
            document.getElementById('cardMessageInput').value = '';
            updateCartUI();

            document.getElementById('orderSuccessModal').classList.remove('hidden');
        }

        function closeSuccessModal() {
            document.getElementById('orderSuccessModal').classList.add('hidden');
        }

        // Toast Helper
        function showToast(message) {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = "bg-anthracite border border-gold-main text-gold-champagne px-4 py-3 rounded-xl shadow-gold-glow text-xs flex items-center gap-2 transition duration-300";
            toast.innerHTML = `<i class="fa-solid fa-gem text-gold-main"></i><span>${message}</span>`;
            
            container.appendChild(toast);
            setTimeout(() => {
                toast.classList.add('opacity-0');
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }
    </script>
</body>
</html>
```html
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hữu Tiến Thành - Giới thiệu bản thân</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #fff0f5;
            color: #444;
        }

        header {
            background: #222;
            color: white;
            padding: 22px;
            text-align: center;
        }

        header h2 {
            margin: 0;
            color: #ffb6d0;
        }

        nav {
            margin-top: 15px;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 0 12px;
        }

        .container {
            max-width: 1000px;
            margin: 45px auto;
            padding: 20px;
        }

        .card {
            background: white;
            border-radius: 25px;
            padding: 35px;
            display: flex;
            align-items: center;
            gap: 35px;
            box-shadow: 0 8px 30px #e8b9cc;
        }

        .avatar-box {
            width: 280px;
            height: 330px;
            flex-shrink: 0;
            border: 5px solid #ffb6d0;
            border-radius: 22px;
            overflow: hidden;
            background: #ffe0eb;
        }

        .avatar-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .avatar-placeholder {
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 20px;
            color: #c2185b;
            font-weight: bold;
        }

        .label {
            display: inline-block;
            background: #ffe0eb;
            color: #c2185b;
            padding: 9px 15px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: bold;
        }

        h1 {
            color: #c2185b;
            font-size: 32px;
        }

        h2 {
            color: #e91e63;
        }

        .info {
            line-height: 1.9;
        }

        .button {
            display: inline-block;
            background: #e91e63;
            color: white;
            padding: 12px 22px;
            border-radius: 25px;
            text-decoration: none;
            margin-top: 12px;
        }

        footer {
            text-align: center;
            padding: 25px;
            color: #888;
        }

        @media (max-width: 700px) {
            .card {
                flex-direction: column;
            }

            .avatar-box {
                width: 230px;
                height: 280px;
            }
        }
    </style>
</head>

<body>

<header>
    <h2>HỮU TIẾN THÀNH</h2>
    <nav>
        <a href="#home">Trang chủ</a>
        <a href="#profile">Giới thiệu</a>
    </nav>
</header>

<main class="container" id="home">
    <section class="card" id="profile">

        <div class="avatar-box" id="avatarBox">
            <div class="avatar-placeholder">
                ẢNH ĐẠI DIỆN<br>
                HỮU TIẾN THÀNH
            </div>
        </div>

        <div class="info">
            <span class="label">THÔNG TIN CÁ NHÂN</span>

            <h1>Giới Thiệu Bản Thân</h1>

            <h2>Xin chào! Mình là Hữu Tiến Thành 👋</h2>

            <p><strong>Họ và tên:</strong> Hữu Tiến Thành</p>
            <p><strong>MSSV:</strong> 25050018</p>
            <p><strong>Ngành học:</strong> Công nghệ thông tin</p>
            <p><strong>Sở thích:</strong> Lập trình và thiết kế website</p>

            <p>
                Mình là Hữu Tiến Thành, sinh viên ngành Công nghệ thông tin.
                Mình yêu thích lập trình, thiết kế website và khám phá công
                nghệ mới. Mình luôn cố gắng học hỏi, rèn luyện kỹ năng và
                phát triển khả năng sáng tạo. Qua các bài tập thực hành,
                mình mong muốn xây dựng những website đẹp mắt, thân thiện
                và dễ sử dụng.
            </p>

            <a class="button" href="#profile">Khám phá bản thân →</a>
        </div>

    </section>
</main>

<footer>
    © 2026 - Hữu Tiến Thành | Bài tập thiết kế website
</footer>

<script>
    // Tự tìm ảnh trong cùng thư mục với file HTML.
    // Nếu không tìm thấy, phần chữ giữ chỗ sẽ được hiển thị.
    const avatarBox = document.getElementById("avatarBox");
    const imageNames = [
        "avatar.jpg",
        "avatar.jpeg",
        "avatar.png",
        "images/avatar.jpg",
        "images/avatar.png"
    ];

    function tryImage(index) {
        if (index >= imageNames.length) {
            return;
        }

        const img = new Image();

        img.onload = function () {
            avatarBox.innerHTML = "";
            img.alt = "Ảnh đại diện Hữu Tiến Thành";
            avatarBox.appendChild(img);
        };

        img.onerror = function () {
            tryImage(index + 1);
        };

        img.src = imageNames[index];
    }

    tryImage(0);
</script>

</body>
</html>
